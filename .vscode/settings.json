{
  "gitlens.gitkraken.mcp.autoEnabled": false,
  "gitlens.gitkraken.cli.integration.enabled": false,
  "gitlens.gitkraken.cli.insiders.enabled": false,
  "terminal.integrated.defaultProfile.osx": "purely-zsh",
  "terminal.integrated.automationProfile.osx": {
    "path": "/bin/zsh"
  },
  "terminal.integrated.profiles.osx": {
    "purely-zsh": {
      "path": "/bin/zsh"
    }
  },
  "terminal.integrated.inheritEnv": true,
  "terminal.integrated.env.osx": {
    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  },
  "files.exclude": {
    "**/.next": true,
    "**/tmp/portal-qa/review-shots": true,
    "**/tmp/portal-qa/review-shots-loaded": true
  },
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/tmp/portal-qa/review-shots/**": true,
    "**/tmp/portal-qa/review-shots-loaded/**": true,
    "**/tmp/portal-qa/*.png": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/tmp/portal-qa/review-shots/**": true,
    "**/tmp/portal-qa/review-shots-loaded/**": true
  }
}
